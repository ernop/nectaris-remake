 "descriptions": {
  "IBEX": "Ibex MM-2 · Mortar crew on foot: indirect fire from mountains no tracked gun can climb",
  "NETTLE": "Nettle SM-3 · Missile crew on foot: shoots aircraft 2-3 hexes away from any terrain",
  "FERRET": "Ferret RS-4 · Skirmisher: strikes, then walks off with the movement it has left",
  "LOCUST": "Locust MR-9 · Rocket truck: the only long-range gun that moves and fires in one turn",
  "CYCLONE": "Cyclone DB-2 · Dual battery: one gun that answers ground or air at 2-3 hexes",
  "WARDEN": "Warden FG-5 · Flak tank: guards a ring 2-3 hexes out, but adjacent aircraft are safe from it",
  "STALKER": "Stalker TD-8 · Hull-down hunter: 85 attack, but only when it has not moved",
  "BADGER": "Badger AV-4 · Armored carrier: 40 defense, tracked, carries one ground unit through wasteland",
  "RHINO": "Rhino AC-3 · Armored capturer: takes factories and the base at 35 defense",
  "REDOUBT": "Redoubt PB-1 · Pillbox: hits adjacent ground and air hard; cannot move",
  "JAVELIN": "Javelin SM-8 · SAM site: 95 attack on aircraft 2-4 hexes out; nothing else",
  "HORNET": "Hornet AH-5 · Attack helicopter: strikes, then flies the rest of its move away",
  "LANCER": "Lancer LX-2 · Stand-off striker: air artillery, fires at 2-3 hexes after flying",
  "MERLIN": "Merlin AX-3 · Missile interceptor: shoots aircraft 2-3 hexes out after flying its full move",
  "DRAGONFLY": "Dragonfly JP-1 · Jump-pack trooper: flying capturer that mountains cannot stop"
 },
