  "descriptions": {
    "BASTION": "Four braced feet, a low armored roof and two outward missile rails.",
    "HYDRA": "An exposed staggered missile rack on a tiny, lightly armored crawler.",
    "TORTOISE": "Long slab skirts, a low casemate and a recessed upward missile slot.",
    "WATCHMAN": "A tall rectangular radar vane, twin missiles and a small ground-defense barrel.",
    "MARTEN": "A small rider, long sidecar missile rail and three exposed wheels.",
    "MIDGE": "A small crouched operator and a slim shoulder missile, with an open lower silhouette.",
    "GORGON": "A deep armored carriage, short heavy mortar and high rear missile mast.",
    "BADGER": "A small operator behind a wheeled breech shield with a short cannon and rear missile.",
    "RAMPART": "A turretless armored wedge with broad side shields and one tiny anti-air stub.",
    "HORNET": "A small infantry figure with a broad rectangular missile pack and separate sight.",
    "ANVIL": "A wide split trail, thick central shield, elevated gun and small side anti-air tube.",
    "BASILISK": "A deep tracked hull with a long gun and a visibly separate twin upward anti-air mount.",
    "LANCER": "A small kneeling gunner, long upward launcher and compact mortar footplate.",
    "STOAT": "A low running operator with a long horizontal anti-tank missile and small backpack.",
    "KESTREL": "A long low crawler with a forward cab, sloped missile bank and tall rear radar fin."
  }
